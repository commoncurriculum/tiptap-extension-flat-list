{
  "name": "tiptap-extension-flat-list",
  "version": "0.1.1",
  "description": "Tiptap extension that adds \"flat\" list items",
  "author": "Common Curriculum, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/commoncurriculum/tiptap-extension-flat-list/issues"
  },
  "homepage": "https://github.com/commoncurriculum/tiptap-extension-flat-list#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commoncurriculum/tiptap-extension-flat-list.git"
  },
  "keywords": [
    "tiptap",
    "list",
    "quill"
  ],
  "main": "build/commonjs/index.js",
  "browser": "build/esm/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "files": [
    "/build",
    "/src"
  ],
  "directories": {
    "lib": "src"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {},
  "peerDependencies": {
    "@tiptap/core": "2.x || 3.x",
    "@tiptap/pm": "2.x || 3.x"
  },
  "devDependencies": {
    "@tiptap/core": "3.0.9",
    "@tiptap/extension-document": "3.0.9",
    "@tiptap/extension-hard-break": "3.0.9",
    "@tiptap/extension-paragraph": "3.0.9",
    "@tiptap/extension-text": "3.0.9",
    "@tiptap/pm": "3.0.9",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "scripts": {
    "start": "vite serve demo",
    "prepack": "pnpm run clean && pnpm run lint && pnpm run build",
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.commonjs.json",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:tsc": "tsc -p tsconfig.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "format": "prettier . --write",
    "typedoc": "pnpm run --sequential \"/^typedoc:.*/\"",
    "typedoc:run": "typedoc --options typedoc.json --tsconfig tsconfig.esm.json src/index.ts",
    "typedoc:open": "open docs/index.html > /dev/null 2>&1 &",
    "clean": "rm -rf build docs"
  }
}
